{
  "name": "qinyu-resume",
  "version": "3.0.0",
  "private": true,
  "description": "秦宇 · 测试开发工程师 — 一站式简历：网站 + A4 一页 PDF + DOCX + ATS 文本，单一数据源生成（Next.js 15 + TypeScript + Tailwind + Motion）",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "gen:ats": "py scripts/gen_ats.py",
    "gen:docx": "py scripts/gen_docx.py",
    "gen:pdf": "node scripts/gen_pdf.mjs",
    "gen:og": "node scripts/gen_og.mjs",
    "gen:all": "npm run gen:ats && npm run gen:docx",
    "gen:assets": "npm run gen:all && npm run gen:pdf && npm run gen:og"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "motion": "^12.0.6",
    "next": "^15.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3"
  }
}
